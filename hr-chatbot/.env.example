DJANGO_SECRET_KEY=change-me-before-you-share-this-environment
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=hr_chat
POSTGRES_USER=hr_chat
POSTGRES_PASSWORD=hr_chat_poc
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# auto uses a local Ollama Llama if it is running, otherwise Groq, otherwise OpenAI.
# Set ollama, groq, or openai to force one provider.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini

CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
